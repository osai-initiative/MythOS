[Unit]
Description=Initialize ConsumerOS protection and snapshot services
Documentation=man:consumerosctl(1)
ConditionPathExists=!/run/live/medium
ConditionPathExists=!/var/lib/consumeros/initialized
After=local-fs.target NetworkManager.service
Before=graphical.target

[Service]
Type=oneshot
ExecStart=/usr/bin/consumerosctl initialize
RemainAfterExit=yes
TimeoutStartSec=5min

[Install]
WantedBy=multi-user.target
