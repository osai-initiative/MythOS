[Desktop Entry]
Name=ConsumerOS Application Installer
Comment=Check compatibility and open portable applications safely
Exec=consumeros-open %f
Icon=org.consumeros.Open
Terminal=false
Type=Application
NoDisplay=true
MimeType=application/vnd.microsoft.portable-executable;application/x-ms-dos-executable;application/x-msdownload;application/x-msi;application/vnd.appimage;application/x-apple-diskimage;
StartupNotify=true

