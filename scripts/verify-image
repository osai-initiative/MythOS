#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
VERSION="$(tr -d '[:space:]' < "${PROJECT_ROOT}/VERSION")"
ARCH="${CONSUMEROS_ARCH:-amd64}"
ISO="${1:-${PROJECT_ROOT}/.build/artifacts/consumeros-${VERSION}-${ARCH}.iso}"
CHECKSUM="${ISO}.sha256"

if [[ ! -s "${ISO}" ]]; then
    printf 'ISO not found: %s\n' "${ISO}" >&2
    exit 2
fi

if [[ -s "${CHECKSUM}" ]]; then
    (cd -- "$(dirname -- "${ISO}")" && sha256sum --check "$(basename -- "${CHECKSUM}")")
fi

inspection_dir="$(mktemp -d)"
cleanup() {
    rm -rf -- "${inspection_dir}"
}
trap cleanup EXIT

xorriso -indev "${ISO}" -pvd_info > "${inspection_dir}/pvd.txt" 2>&1
xorriso -indev "${ISO}" -report_el_torito as_mkisofs > "${inspection_dir}/eltorito.txt" 2>&1
xorriso -osirrox on -indev "${ISO}" \
    -extract /live/filesystem.squashfs "${inspection_dir}/filesystem.squashfs" \
    -extract /live/filesystem.packages "${inspection_dir}/filesystem.packages" \
    -extract /boot/grub/config.cfg "${inspection_dir}/grub-config.cfg" \
    -extract /boot/grub/grub.cfg "${inspection_dir}/grub.cfg" \
    -extract /isolinux/isolinux.cfg "${inspection_dir}/isolinux.cfg" \
    -extract /isolinux/live.cfg "${inspection_dir}/isolinux-live.cfg" \
    > "${inspection_dir}/extract.txt" 2>&1

if ! rg -q -- '-b .*(isolinux|syslinux)' "${inspection_dir}/eltorito.txt"; then
    printf 'ISO does not advertise the BIOS El Torito image.\n' >&2
    exit 3
fi
if ! rg -q -- '-e .*(efi|EFI)' "${inspection_dir}/eltorito.txt"; then
    printf 'ISO does not advertise the UEFI El Torito image.\n' >&2
    exit 3
fi

if ! rg -q '^set timeout=5$' "${inspection_dir}/grub-config.cfg"; then
    printf 'UEFI boot menu does not auto-start the live system.\n' >&2
    exit 3
fi
if ! rg -q '^timeout 50$' "${inspection_dir}/isolinux.cfg"; then
    printf 'BIOS boot menu does not auto-start the live system.\n' >&2
    exit 3
fi
for menu in "${inspection_dir}/grub.cfg" "${inspection_dir}/isolinux-live.cfg"; do
    for choice in 'Try ConsumerOS' 'Install ConsumerOS' 'Repair an existing installation'; do
        if ! rg -F -q "${choice}" "${menu}"; then
            printf 'Boot menu is missing choice: %s\n' "${choice}" >&2
            exit 3
        fi
    done
done

for package in consumeros-core gnome-core calamares flatpak snapper; do
    if ! rg -q "^${package}[[:space:]]" "${inspection_dir}/filesystem.packages"; then
        printf 'Required image package is absent: %s\n' "${package}" >&2
        exit 4
    fi
done

unsquashfs -ll "${inspection_dir}/filesystem.squashfs" > "${inspection_dir}/squashfs.txt"
for path in \
    squashfs-root/usr/bin/consumeros \
    squashfs-root/usr/bin/consumerosctl \
    squashfs-root/usr/share/applications/org.consumeros.SystemHub.desktop \
    squashfs-root/usr/share/gnome-shell/extensions/consumeros-shell@consumeros.local/extension.js \
    squashfs-root/etc/calamares/settings.conf \
    squashfs-root/usr/lib/systemd/system/consumeros-offline-update.service; do
    if ! rg -F -q "${path}" "${inspection_dir}/squashfs.txt"; then
        printf 'Required image path is absent: %s\n' "${path#squashfs-root}" >&2
        exit 5
    fi
done

iso_size="$(stat --format='%s' "${ISO}")"
printf 'image verification: ok (%s bytes, BIOS + UEFI, required payload present)\n' "${iso_size}"
